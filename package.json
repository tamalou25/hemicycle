{
  "name": "hemicycle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hémicycle — simulation politique de la France, tour par tour",
  "scripts": {
    "test": "vitest run",
    "build:css": "tailwindcss -i src/styles/app.src.css -o assets/app.css --minify",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:tout": "vitest run && playwright test",
    "build:sw": "node scripts/generer-sw.js",
    "build": "npm run build:css && npm run build:sw",
    "build:mobile": "npm run build && node scripts/construire-mobile.js",
    "cap:sync": "npm run build:mobile && npx cap sync",
    "cap:android": "npm run cap:sync && npx cap open android",
    "cap:ios": "npm run cap:sync && npx cap open ios"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capacitor/cli": "^8.6.0",
    "@fontsource/source-serif-4": "^5.1.1",
    "@playwright/test": "^1.63.0",
    "tailwindcss": "^3.4.17",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/share": "^8.0.3"
  }
}
